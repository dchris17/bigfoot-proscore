# Copy this to .env.local and fill in the values.
# Never commit .env.local to git.

# Database (Railway Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# FieldRoutes API (copy from fieldroutes-mcp service in Railway)
FIELDROUTES_SUBDOMAIN=aversepest
FIELDROUTES_AUTH_KEY=
FIELDROUTES_AUTH_TOKEN=

# Bouncie OAuth (from bouncie.dev app you create in Phase 4)
BOUNCIE_CLIENT_ID=
BOUNCIE_CLIENT_SECRET=
BOUNCIE_REDIRECT_URI=https://score.gobigfootpest.com/api/bouncie/callback

# Google OAuth for manager sign-in (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Service Account for reading Zapier reviews sheet (Phase 5)
GOOGLE_SERVICE_ACCOUNT_JSON=
REVIEWS_SHEET_ID=

# Auth / sessions
AUTH_SECRET=
SESSION_SECRET=

# Manager emails (comma-separated, no spaces)
MANAGER_EMAILS=dan@gobigfootpest.com,spencer@gobigfootpest.com,kelly@gobigfootpest.com,dvdmcx@gmail.com

# App settings
APP_TIMEZONE=America/Boise
NEXT_PUBLIC_APP_URL=https://score.gobigfootpest.com
